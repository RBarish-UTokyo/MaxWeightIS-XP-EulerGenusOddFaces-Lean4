  | .fork l r => do return .fork (← (l.eval regs).asPointer) (← (r.eval regs).asPointer)
  | .bucket p => do return .bucket (← (p.eval regs).asPointer)
  | .pair a b => do return .pair (← (a.eval regs).asPointer) (← (b.eval regs).asPointer)

