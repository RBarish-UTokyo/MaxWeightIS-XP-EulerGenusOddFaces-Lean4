namespace WeightedMIS.RegisterMachine

open WeightedMIS.PointerMemory

abbrev Register := Fin 16

inductive Value
  | pointer (p : Ptr)
  | flag (b : Bool)
  deriving DecidableEq, Repr

abbrev Registers := Register → Value

def Value.word : Value → Word
