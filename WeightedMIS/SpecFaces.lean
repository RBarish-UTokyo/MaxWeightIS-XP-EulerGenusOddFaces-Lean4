module

public import WeightedMIS.SpecConnectivity
public import WeightedMIS.EmbeddingEuler

/-!
# Statement faces are the traced ribbon circles

The statement defines a face as a class of flags under the equivalence
relation generated by `along` and `corner`. Internally a face is an
unoriented rotation circle of the traced corner system. The two quotients are
identified, so the statement Euler genus is the Euler genus of the internal
cellular embedding.
-/

@[expose] public section

namespace WeightedMIS.Spec

namespace Map

variable (A : Map) (hA : A.IsClosedSurface)

/-- The internal boundary rotation is `corner ∘ along` on statement flags. -/
theorem ribbon_rotation (x : Flag (Fin A.edges)) :
    (A.ribbon hA).rotation (Flag.equiv _ x) = Flag.equiv _ (A.corner x.along) := by
  change (A.ribbon hA).corner (EmbeddingFaces.SidePairing.along (Flag.equiv _ x)) = _
  rw [← Flag.equiv_along, A.ribbon_corner hA]

/-- One face step keeps the internal ribbon circle. -/
theorem faceOf_faceStep {x y : Flag (Fin A.edges)} (h : A.FaceStep x y) :
    (A.ribbon hA).faceOf (Flag.equiv _ x) = (A.ribbon hA).faceOf (Flag.equiv _ y) := by
  rcases h with rfl | rfl
  · rw [Flag.equiv_along, EmbeddingFaces.Ribbon.faceOf_along]
  · have hrot : Flag.equiv _ (A.corner x) =
        (A.ribbon hA).rotation (Flag.equiv _ x.along) := by
      rw [A.ribbon_rotation hA, Flag.along_along]
    rw [hrot, ← (A.ribbon hA).faceOf_eq_of_sameCycle
      ((Equiv.Perm.sameCycle_apply_right).mpr (Equiv.Perm.SameCycle.refl _ _)),
      Flag.equiv_along, EmbeddingFaces.Ribbon.faceOf_along]

/-- Flags on one internal ribbon circle are related by any relation that
contains the statement face steps. -/
theorem quot_eq_of_sameFace (r : Flag (Fin A.edges) → Flag (Fin A.edges) → Prop)
    (hr : ∀ x y, A.FaceStep x y → r x y) {x y : Flag (Fin A.edges)}
    (h : (A.ribbon hA).SameFace (Flag.equiv _ x) (Flag.equiv _ y)) :
    Quot.mk r x = Quot.mk r y := by
  have halong : ∀ z : Flag (Fin A.edges), Quot.mk r z = Quot.mk r z.along :=
    fun z => Quot.sound (hr _ _ (Or.inl rfl))
  have hrot : ∀ z : Flag (Fin A.edges),
      Quot.mk r ((Flag.equiv _).symm ((A.ribbon hA).rotation (Flag.equiv _ z))) = Quot.mk r z := by
    intro z
    rw [A.ribbon_rotation hA, Equiv.symm_apply_apply, halong z]
    exact (Quot.sound (hr _ _ (Or.inr rfl))).symm
  have hiter : ∀ (n : ℕ) (z : Flag (Fin A.edges)),
      Quot.mk r ((Flag.equiv _).symm (((A.ribbon hA).rotation ^ n) (Flag.equiv _ z))) =
        Quot.mk r z := by
    intro n
    induction n with
    | zero => intro z; simp
    | succ n ih =>
        intro z
        rw [pow_succ', Equiv.Perm.mul_apply]
        have h1 := hrot ((Flag.equiv _).symm (((A.ribbon hA).rotation ^ n) (Flag.equiv _ z)))
        rw [Equiv.apply_symm_apply] at h1
        rw [h1, ih]
  have hcycle : ∀ a b : Flag (Fin A.edges),
      (A.ribbon hA).rotation.SameCycle (Flag.equiv _ a) (Flag.equiv _ b) →
        Quot.mk r a = Quot.mk r b := by
    intro a b hab
    obtain ⟨n, hn⟩ := hab.exists_nat_pow_eq
    rw [← hiter n a, hn, Equiv.symm_apply_apply]
  rcases h with h | h
  · exact hcycle x y h
  · rw [← Flag.equiv_along] at h
    exact (hcycle x y.along h).trans (halong y).symm

/-- Statement faces are exactly the internal ribbon circles. -/
noncomputable def faceEquiv : A.Face ≃ (A.ribbon hA).FaceIndex where
  toFun := Quot.lift (fun x => (A.ribbon hA).faceOf (Flag.equiv _ x))
    (fun _ _ h => A.faceOf_faceStep hA h)
  invFun := Quotient.lift (fun y => Quot.mk A.FaceStep ((Flag.equiv _).symm y))
    (fun a b h => by
      apply A.quot_eq_of_sameFace hA A.FaceStep (fun _ _ h => h)
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      exact h)
  left_inv := by
    intro f
    induction f using Quot.ind
    rfl
  right_inv := by
    intro f
    induction f using Quotient.ind
    rfl

@[simp] theorem faceEquiv_mk (x : Flag (Fin A.edges)) :
    A.faceEquiv hA (Quot.mk _ x) = (A.ribbon hA).faceOf (Flag.equiv _ x) := rfl

/-- The statement Euler genus is the Euler genus of the internal embedding. -/
theorem cellular_eulerGenus [Fintype (A.ribbon hA).FaceIndex] :
    (A.cellular hA).eulerGenus = A.eulerGenus := by
  unfold EmbeddingFaces.CellularEmbedding.eulerGenus eulerGenus
  rw [Nat.card_congr (A.faceEquiv hA), Nat.card_eq_fintype_card, Fintype.card_fin,
    Fintype.card_fin]

end Map

end WeightedMIS.Spec
