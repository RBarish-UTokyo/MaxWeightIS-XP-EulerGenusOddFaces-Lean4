module

public import WeightedMIS.OddRow

/-!
# Connected components of actual endpoint graphs

Components are the quotient by finite edge-walk reachability. Both vertex and
edge partitions are explicit equivalences, and each induced endpoint graph is
proved connected by lifting the original walks.
-/

@[expose] public section

namespace WeightedMIS.Incidence

variable {V E : Type*} (left right : E → V)

/-- Reachability by a genuine finite endpoint walk. -/
def Reachable (a b : V) : Prop := ∃ n, Walk left right a b n

theorem reachable_refl (a : V) : Reachable left right a a := ⟨0, .nil a⟩

theorem reachable_symm {a b : V} (h : Reachable left right a b) :
    Reachable left right b a := by
  obtain ⟨n, p⟩ := h
  exact ⟨n, OddRow.walk_reverse left right p⟩

theorem reachable_trans {a b c : V} (h : Reachable left right a b)
    (k : Reachable left right b c) : Reachable left right a c := by
  obtain ⟨n, p⟩ := h
  obtain ⟨m, q⟩ := k
  exact ⟨n + m, OddRow.walk_append left right p q⟩

/-- The equivalence relation generated by the actual edge traversals. -/
def componentSetoid : Setoid V where
  r := Reachable left right
  iseqv := ⟨reachable_refl left right, reachable_symm left right,
    reachable_trans left right⟩

/-- Connected components, including isolated graph vertices. -/
abbrev Component := Quotient (componentSetoid left right)

noncomputable instance [Finite V] : Fintype (Component left right) := Fintype.ofFinite _

/-- The actual component of a supplied vertex. -/
def componentOf (v : V) : Component left right := Quotient.mk _ v

theorem componentOf_eq_iff (a b : V) :
    componentOf left right a = componentOf left right b ↔ Reachable left right a b :=
  ⟨fun h => Quotient.exact h, fun h => Quotient.sound h⟩

@[simp] theorem componentOf_endpoints (e : E) :
    componentOf left right (left e) = componentOf left right (right e) :=
  Quotient.sound ⟨1, .forward e rfl (.nil _)⟩

theorem componentOf_walk {a b : V} {n : ℕ} (p : Walk left right a b n) :
    componentOf left right a = componentOf left right b := Quotient.sound ⟨n, p⟩

/-- Vertex labels in one walk-connected component. -/
abbrev ComponentVertex (q : Component left right) := {v : V // componentOf left right v = q}

/-- Edge labels belonging to one component; either endpoint gives the same label. -/
abbrev ComponentEdge (q : Component left right) := {e : E // componentOf left right (left e) = q}

/-- The left endpoint, now carrying its actual component membership. -/
def componentLeft (q : Component left right) (e : ComponentEdge left right q) :
    ComponentVertex left right q := ⟨left e.val, e.property⟩

/-- The right endpoint belongs to the same actual walk component. -/
def componentRight (q : Component left right) (e : ComponentEdge left right q) :
    ComponentVertex left right q :=
  ⟨right e.val, (componentOf_endpoints left right e.val).symm.trans e.property⟩

/-- Every original vertex occurs in exactly one component. -/
def vertexPartition : V ≃ ((q : Component left right) × ComponentVertex left right q) where
  toFun v := ⟨componentOf left right v, v, rfl⟩
  invFun qv := qv.2.val
  left_inv _ := rfl
  right_inv := by rintro ⟨q, v, h⟩; subst q; rfl

/-- Every original edge occurs in exactly one component. -/
def edgePartition : E ≃ ((q : Component left right) × ComponentEdge left right q) where
  toFun e := ⟨componentOf left right (left e), e, rfl⟩
  invFun qe := qe.2.val
  left_inv _ := rfl
  right_inv := by rintro ⟨q, e, h⟩; subst q; rfl

/-- A walk stays inside the component of its initial vertex. -/
theorem walk_in_component {a b : V} {n : ℕ} (p : Walk left right a b n)
    (q : Component left right) (ha : componentOf left right a = q) :
    Walk (componentLeft left right q) (componentRight left right q)
      ⟨a, ha⟩ ⟨b, (componentOf_walk left right p).symm.trans ha⟩ n := by
  induction p with
  | nil => exact .nil _
  | @forward b n e hb p ih =>
      subst b
      let e' : ComponentEdge left right q := ⟨e, (componentOf_walk left right p).symm.trans ha⟩
      exact Walk.forward e' rfl ih
  | @backward b n e hb p ih =>
      subst b
      let e' : ComponentEdge left right q := ⟨e,
        (componentOf_endpoints left right e).trans ((componentOf_walk left right p).symm.trans ha)⟩
      exact Walk.backward e' rfl ih

/-- The induced endpoint graph of every actual component is connected. -/
theorem component_connected (q : Component left right) :
    Connected (componentLeft left right q) (componentRight left right q) := by
  intro a b
  obtain ⟨n, p⟩ := (componentOf_eq_iff left right a.val b.val).mp
    (a.property.trans b.property.symm)
  exact ⟨n, walk_in_component left right p q a.property⟩

/-- Every quotient component contains a supplied vertex. -/
theorem componentVertex_nonempty (q : Component left right) :
    Nonempty (ComponentVertex left right q) :=
  ⟨⟨Quotient.out q, Quotient.out_eq q⟩⟩

/-- A component with no edges consists of exactly one original vertex. -/
theorem componentVertex_subsingleton (q : Component left right)
    [IsEmpty (ComponentEdge left right q)] : Subsingleton (ComponentVertex left right q) := by
  refine ⟨fun a b => ?_⟩
  obtain ⟨n, p⟩ := component_connected left right q a b
  cases p with
  | nil => rfl
  | forward e => exact isEmptyElim e
  | backward e => exact isEmptyElim e

/-- In a connected graph with an edge, every vertex is an actual endpoint. -/
theorem connected_vertex_incident (hc : Connected left right) (hne : Nonempty E) (v : V) :
    ∃ e : E, left e = v ∨ right e = v := by
  obtain ⟨e⟩ := hne
  obtain ⟨n, p⟩ := hc (left e) v
  cases p with
  | nil => exact ⟨e, Or.inl rfl⟩
  | forward f => exact ⟨f, Or.inr rfl⟩
  | backward f => exact ⟨f, Or.inl rfl⟩

/-- Having an edge in a component is equivalent to incidence at each of its
vertices. This identifies the missing flags precisely with isolated vertices. -/
theorem componentEdge_nonempty_iff (v : V) :
    Nonempty (ComponentEdge left right (componentOf left right v)) ↔
      ∃ e : E, left e = v ∨ right e = v := by
  constructor
  · intro hne
    obtain ⟨e, he⟩ := connected_vertex_incident
      (componentLeft left right _) (componentRight left right _)
      (component_connected left right _) hne ⟨v, rfl⟩
    exact ⟨e.val, he.imp (congrArg Subtype.val) (congrArg Subtype.val)⟩
  · rintro ⟨e, he | he⟩
    · exact ⟨⟨e, congrArg (componentOf left right) he⟩⟩
    · exact ⟨⟨e, (componentOf_endpoints left right e).trans
        (congrArg (componentOf left right) he)⟩⟩

/-- Isolated supplied vertices, including labels with no flag at all. -/
abbrev IsolatedVertex := {v : V // ¬ ∃ e : E, left e = v ∨ right e = v}

/-- Edge-free components correspond exactly to isolated original vertices. -/
noncomputable def isolatedComponentEquiv :
    {q : Component left right // ¬Nonempty (ComponentEdge left right q)} ≃
      IsolatedVertex left right where
  toFun q := ⟨Quotient.out q.val, by
    intro h
    have hn := (componentEdge_nonempty_iff left right (Quotient.out q.val)).mpr h
    rw [show componentOf left right (Quotient.out q.val) = q.val from Quotient.out_eq q.val] at hn
    exact q.property hn⟩
  invFun v := ⟨componentOf left right v.val,
    fun he => v.property ((componentEdge_nonempty_iff left right v.val).mp he)⟩
  left_inv := by intro q; apply Subtype.ext; exact Quotient.out_eq q.val
  right_inv := by
    intro v
    apply Subtype.ext
    change Quotient.out (componentOf left right v.val) = v.val
    let q := componentOf left right v.val
    let : IsEmpty (ComponentEdge left right q) := not_nonempty_iff.mp
      (fun he => v.property ((componentEdge_nonempty_iff left right v.val).mp he))
    let : Subsingleton (ComponentVertex left right q) := componentVertex_subsingleton left right q
    exact congrArg (fun z : ComponentVertex left right q => z.val) (Subsingleton.elim
      (⟨Quotient.out q, Quotient.out_eq q⟩ : ComponentVertex left right q) ⟨v.val, rfl⟩)

end WeightedMIS.Incidence
