module

public import WeightedMIS.Lift

/-!
# Sparse arc count of the actual expanded graph

Each arc is generated by a hub entry, a hub exit, or an original directed arc
with an anchor, signature, and parity. A candidate determines at most one target
signature. Choosing a generator therefore injects actual graph arcs into the
finite candidate set, including when coincident arcs have collapsed.
-/

@[expose] public section

namespace WeightedMIS.SparseSize

open WeightedMIS.Walks WeightedMIS.Expanded WeightedMIS.Lift

/-- Possible entry, exit, and edge-move generators. Candidates for an edge move
may be invalid because the updated signature leaves the finite box. -/
abbrev Candidate {Row Edge : Type*} (C : Edge → Column Row) (Coord : Type*) (m : ℕ) :=
  (State Row × Box Coord m × ZMod 2) ⊕
    (State Row × Box Coord m × ZMod 2) ⊕
      (State Row × Arc C × Box Coord m × ZMod 2)

/-- A candidate generates an actual arc when its prescribed endpoints agree. -/
def Generates {Row Edge Coord : Type*} (C : Edge → Column Row)
    (W : Edge → Coord → ℤ) (π : Edge → ZMod 2) (m : ℕ)
    (c : Candidate C Coord m) (a : GraphArc C W π m) : Prop :=
  match c with
  | .inl (anchor, z, p) =>
      a.val = (.hub z p, none, .work anchor anchor z p)
  | .inr (.inl (anchor, z, p)) =>
      a.val = (.work anchor anchor z p, none, .hub z p)
  | .inr (.inr (anchor, e, z, p)) =>
      ∃ z' : Box Coord m,
        (∀ r, coordinate z' r = coordinate z r + W e.val.1 r) ∧
        a.val = (.work anchor (source C e) z p, some e.val.1,
          .work anchor (target C e) z' (p + π e.val.1))

/-- Every actual arc has a generating candidate. -/
theorem exists_generator {Row Edge Coord : Type*} (C : Edge → Column Row)
    (W : Edge → Coord → ℤ) (π : Edge → ZMod 2) (m : ℕ)
    (a : GraphArc C W π m) : ∃ c : Candidate C Coord m, Generates C W π m c a := by
  rcases a with ⟨⟨s, label, t⟩, h⟩
  cases h with
  | enter anchor z p => exact ⟨.inl (anchor, z, p), rfl⟩
  | exit anchor z p => exact ⟨.inr (.inl (anchor, z, p)), rfl⟩
  | move anchor e z z' p hz =>
      exact ⟨.inr (.inr (anchor, e, z, p)), z', hz, rfl⟩

/-- A move's coordinate equations determine its target signature uniquely. -/
theorem generator_unique {Row Edge Coord : Type*} (C : Edge → Column Row)
    (W : Edge → Coord → ℤ) (π : Edge → ZMod 2) (m : ℕ)
    (c : Candidate C Coord m) (a b : GraphArc C W π m)
    (ha : Generates C W π m c a) (hb : Generates C W π m c b) : a = b := by
  apply Subtype.ext
  cases c with
  | inl c =>
      rcases c with ⟨anchor, z, p⟩
      exact ha.trans hb.symm
  | inr c =>
      cases c with
      | inl c =>
          rcases c with ⟨anchor, z, p⟩
          exact ha.trans hb.symm
      | inr c =>
          rcases c with ⟨anchor, e, z, p⟩
          obtain ⟨za, hza, hea⟩ := ha
          obtain ⟨zb, hzb, heb⟩ := hb
          have hz : za = zb := box_ext (fun r => (hza r).trans (hzb r).symm)
          rw [hz] at hea
          exact hea.trans heb.symm

/-- Choose one generator for each actual arc. -/
noncomputable def generatorCode {Row Edge Coord : Type*} (C : Edge → Column Row)
    (W : Edge → Coord → ℤ) (π : Edge → ZMod 2) (m : ℕ)
    (a : GraphArc C W π m) : Candidate C Coord m :=
  Classical.choose (exists_generator C W π m a)

/-- Distinct actual arcs cannot share a chosen generator. -/
theorem generatorCode_injective {Row Edge Coord : Type*} (C : Edge → Column Row)
    (W : Edge → Coord → ℤ) (π : Edge → ZMod 2) (m : ℕ) :
    Function.Injective (generatorCode C W π m) := by
  intro a b h
  have ha := Classical.choose_spec (exists_generator C W π m a)
  have hb := Classical.choose_spec (exists_generator C W π m b)
  change Generates C W π m (generatorCode C W π m a) a at ha
  change Generates C W π m (generatorCode C W π m b) b at hb
  rw [← h] at hb
  exact generator_unique C W π m _ _ _ ha hb

/-- The actual expanded graph has at most 4Sq(m+1) arcs when the box radius is
2m and m is the edge count. This more general form keeps the radius parameter
separate from the number of edges. -/
theorem graphArc_card_le {Row Edge Coord : Type*}
    [Fintype Row] [DecidableEq Row] [Fintype Edge] [Fintype Coord]
    (C : Edge → Column Row) (W : Edge → Coord → ℤ) (π : Edge → ZMod 2) (radius : ℕ) :
    Fintype.card (GraphArc C W π radius) ≤
      4 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1) *
        (Fintype.card Edge + 1) := by
  classical
  have hinj := Fintype.card_le_of_injective (generatorCode C W π radius)
    (generatorCode_injective C W π radius)
  have ha := arc_card_le C
  have hc : Fintype.card (Candidate C Coord radius) =
      4 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1) +
        2 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1) * Fintype.card (Arc C) := by
    simp only [Candidate, Fintype.card_sum, Fintype.card_prod, ZMod.card, state_card,
      Box, Fintype.card_fun, Fintype.card_fin]
    ring
  rw [hc] at hinj
  have hm := Nat.mul_le_mul_left
    (2 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1)) ha
  calc
    Fintype.card (GraphArc C W π radius) ≤
        4 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1) +
          2 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1) * Fintype.card (Arc C) := hinj
    _ ≤ 4 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1) +
          2 * (4 * radius + 1) ^ Fintype.card Coord * (2 * Fintype.card Row + 1) * (2 * Fintype.card Edge) :=
      Nat.add_le_add_left hm _
    _ = _ := by ring

end WeightedMIS.SparseSize
