module

public import WeightedMIS.SearchConstruction
public import WeightedMIS.RadixConstruction
public import WeightedMIS.EfficientSearchRecovery
public import WeightedMIS.IntegerEdgeCosts

/-!
# Sparse encoded graph for the expanded-state search

Vertices use their explicit positional IDs. Outgoing lists are generated by
the local expanded-state rules and stored in a binary trie. Original edge
weights are natural numerators with hub transitions of weight zero.
-/

@[expose] public section

namespace WeightedMIS.SparseSearchGraph

open Expanded NodeEncoding EfficientSearch

/-- Store a bounded natural number in a fixed-width big-endian word. -/
def encodeBits : (width : ℕ) → ℕ → Bits width
  | 0, _ => .nil
  | width + 1, value =>
      .cons (decide (2 ^ width ≤ value)) (encodeBits width (value % 2 ^ width))

theorem encodeBits_value (width value : ℕ) (h : value < 2 ^ width) :
    (encodeBits width value).value = value := by
  induction width generalizing value with
  | zero =>
      have hv : value = 0 := by simpa using h
      simp [encodeBits, Bits.value, hv]
  | succ width ih =>
      have hp : 0 < 2 ^ width := by positivity
      have hv := ih (value % 2 ^ width) (Nat.mod_lt _ hp)
      simp only [encodeBits, Bits.value, hv]
      by_cases hlt : value < 2 ^ width
      · simp [Nat.not_le.mpr hlt, Nat.mod_eq_of_lt hlt]
      · have hle : 2 ^ width ≤ value := Nat.le_of_not_gt hlt
        have hsub : value - 2 ^ width < 2 ^ width := by
          rw [pow_succ] at h
          omega
        rw [Nat.mod_eq_sub_mod hle, Nat.mod_eq_of_lt hsub]
        simp only [hle, decide_true, ↓reduceIte]
        omega

theorem encodeBits_injective {width : ℕ} {a b : ℕ}
    (ha : a < 2 ^ width) (hb : b < 2 ^ width)
    (heq : encodeBits width a = encodeBits width b) : a = b := by
  have h := congrArg Bits.value heq
  simpa only [encodeBits_value width a ha, encodeBits_value width b hb] using h

def vertexWidth (r d radius : ℕ) : ℕ := (nodeCount r d radius).size

def vertexKey {r d radius : ℕ} (v : Fin (nodeCount r d radius)) :
    Bits (vertexWidth r d radius) := encodeBits _ v.val

@[simp] theorem vertexKey_value {r d radius : ℕ} (v : Fin (nodeCount r d radius)) :
    (vertexKey v).value = v.val :=
  encodeBits_value _ _ (v.isLt.trans (Nat.lt_size_self _))

theorem vertexKey_injective {r d radius : ℕ} :
    Function.Injective (@vertexKey r d radius) := by
  intro a b h
  apply Fin.ext
  simpa using congrArg Bits.value h

def nodeKey {r d radius : ℕ} (v : Node (Fin r) (Fin d) radius) :
    Bits (vertexWidth r d radius) := vertexKey (nodeEquiv r d radius v)

/-- A total decoder; valid graph keys always use its first branch. -/
def decodeNode {r d radius : ℕ} (key : Bits (vertexWidth r d radius)) :
    Node (Fin r) (Fin d) radius :=
  if h : key.value < nodeCount r d radius then
    (nodeEquiv r d radius).symm ⟨key.value, h⟩
  else .hub (zeroBox (Fin d) radius) 0

@[simp] theorem decode_vertexKey {r d radius : ℕ} (v : Fin (nodeCount r d radius)) :
    decodeNode (vertexKey v) = (nodeEquiv r d radius).symm v := by
  simp [decodeNode, vertexKey_value, v.isLt]

@[simp] theorem decode_nodeKey {r d radius : ℕ} (v : Node (Fin r) (Fin d) radius) :
    decodeNode (nodeKey v) = v := by simp [nodeKey]

/-- Sparse uniform bound on the total adjacency-list length. -/
def entryBound (r m d radius : ℕ) : ℕ := nodeCount r d radius * (2 * r + 2 * m + 2)

/-- The sum of nonnegative original-edge numerators bounds each arc weight. -/
def weightBound {m : ℕ} (w : Fin m → ℕ) : ℕ := ∑ e, w e

theorem labelValue_le {m : ℕ} (w : Fin m → ℕ) (label : Option (Fin m)) :
    labelValue w label ≤ weightBound w := by
  cases label with
  | none => exact Nat.zero_le _
  | some e => exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ e)

/-- Enough bits for every queued distance, including the extra extraction fuel. -/
def costWidth {m : ℕ} (r d radius : ℕ) (w : Fin m → ℕ) : ℕ :=
  ((entryBound r m d radius + 2) * weightBound w).size

theorem weight_lt_capacity {m : ℕ} (r d radius : ℕ) (w : Fin m → ℕ)
    (label : Option (Fin m)) : labelValue w label < 2 ^ costWidth r d radius w := by
  have hl := labelValue_le w label
  have hm : weightBound w ≤ (entryBound r m d radius + 2) * weightBound w := by nlinarith
  exact (hl.trans hm).trans_lt (Nat.lt_size_self _)

/-- Encode an outgoing target, exact natural weight, and original-edge label. -/
def encodedArc {r m d radius : ℕ} (w : Fin m → ℕ)
    (entry : Option (Fin m) × Fin (nodeCount r d radius)) :
    EfficientSearch.Arc (Option (Fin m)) (vertexWidth r d radius) (costWidth r d radius w) :=
  ⟨vertexKey entry.2, encodeBits _ (labelValue w entry.1), entry.1⟩

@[simp] theorem encodedArc_weight {r m d radius : ℕ} (w : Fin m → ℕ)
    (entry : Option (Fin m) × Fin (nodeCount r d radius)) :
    (encodedArc w entry).weight.value = labelValue w entry.1 :=
  encodeBits_value _ _ (weight_lt_capacity r d radius w entry.1)

/-- Enumerate only the actual outgoing lists, never vertex pairs. -/
def entries {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ) (w : Fin m → ℕ) :
    List (RawArc (Option (Fin m)) (vertexWidth r d radius) (costWidth r d radius w)) :=
  (List.finRange (nodeCount r d radius)).flatMap fun s =>
    (SearchConstruction.encodedOutgoing C W π radius s).map fun e => (vertexKey s, encodedArc w e)

def graph {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ) (w : Fin m → ℕ) :
    Graph (Option (Fin m)) (vertexWidth r d radius) (costWidth r d radius w) :=
  Radix.fromEntries (entries C W π radius w)

theorem graph_canonical {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ) (w : Fin m → ℕ) :
    (graph C W π radius w).canonical := Radix.fromEntries_canonical _

theorem mem_graph_iff {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ) (w : Fin m → ℕ)
    (edge : RawArc (Option (Fin m)) (vertexWidth r d radius) (costWidth r d radius w)) :
    edge ∈ (graph C W π radius w).elements ↔
      ∃ s e, e ∈ SearchConstruction.encodedOutgoing C W π radius s ∧
        (vertexKey s, encodedArc w e) = edge := by
  simp only [graph, Radix.mem_fromEntries, entries, List.mem_flatMap, List.mem_map,
    List.mem_finRange, true_and]

theorem encodedOutgoing_length_le {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ)
    (s : Fin (nodeCount r d radius)) :
    (SearchConstruction.encodedOutgoing C W π radius s).length ≤ 2 * r + 2 * m + 2 := by
  simp only [SearchConstruction.encodedOutgoing, List.length_map]
  cases (nodeEquiv r d radius).symm s with
  | hub z p => rw [SearchConstruction.hub_outgoing_length]; omega
  | work a v z p =>
      have h := SearchConstruction.working_outgoing_length_le C W π radius a v z p
      omega

theorem graph_size_le {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ) (w : Fin m → ℕ) :
    (graph C W π radius w).elements.length ≤ entryBound r m d radius := by
  rw [graph, Radix.fromEntries_size]
  unfold entries
  rw [List.length_flatMap]
  simp only [List.length_map]
  calc
    _ ≤ ((List.finRange (nodeCount r d radius)).map
      (fun _ => 2 * r + 2 * m + 2)).sum :=
        List.sum_le_sum fun s _ => encodedOutgoing_length_le C W π radius s
    _ = _ := by simp [entryBound]

theorem graph_weight_bound {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ) (w : Fin m → ℕ) :
    GraphBound (graph C W π radius w) (weightBound w) := by
  intro edge he
  obtain ⟨s, e, _he, rfl⟩ := (mem_graph_iff C W π radius w edge).mp he
  simp only [encodedArc_weight]
  exact labelValue_le w e.1

theorem graph_no_overflow_width {r m d : ℕ} (C : Fin m → Walks.Column (Fin r))
    (W : Fin m → Fin d → ℤ) (π : Fin m → ZMod 2) (radius : ℕ) (w : Fin m → ℕ) :
    ((graph C W π radius w).elements.length + 2) * weightBound w <
      2 ^ costWidth r d radius w := by
  have hsize := graph_size_le C W π radius w
  exact (Nat.mul_le_mul_right (weightBound w) (Nat.add_le_add_right hsize 2)).trans_lt
    (Nat.lt_size_self _)

end WeightedMIS.SparseSearchGraph
