module

public import WeightedMIS.RegisterGraphEnumeration
public import WeightedMIS.RegisterMachineFrames

/-! # One fixed finite expanded-graph enumeration program -/

@[expose] public section

namespace WeightedMIS.ExpandedEnumerationProgram

open WeightedMIS.PointerMemory WeightedMIS.RegisterMachine WeightedMIS.EfficientSearch
open WeightedMIS.ExpandedWords WeightedMIS.EfficientSearch.Pointer

/-- The procedure table is independent of graph size, genus and word width. -/
def arithmetic : RegisterHorner.Procedures 33 := ⟨0,1,2,3,4,5,6⟩
def division : RegisterDivision.Procedures 33 := ⟨2,7,8,4,5,9,10,6,11⟩
def moves : RegisterCandidate.Procedures 33 := ⟨7,15,0,9,16,17⟩
def work : RegisterWorkSource.Procedures 33 := ⟨20,21,19,18,22⟩
def procedures : RegisterGraphEnumeration.Procedures 33 :=
  ⟨work,moves,arithmetic,division,14,10,12,13,24,28,27,26,25,29,23,30,31⟩

def program : Code 33 := fun i => match i.val with
  | 0 => RegisterHorner.hornerBody 0 1 6
  | 1 => RegisterMultiplier.multiplyBody 2 3
  | 2 => RegisterZero.zeroBody 2
  | 3 => RegisterMultiplier.multiplyAccBody 3 4 6
  | 4 => RegisterShift.shiftInBody 5
  | 5 => RegisterShift.snocBody 5
  | 6 => RegisterAdder.adderBody 6
  | 7 => RegisterComparator.comparatorBody 7
  | 8 => RegisterDivision.auxBody 8 4 7 9
  | 9 => RegisterSubtractor.subtractorBody 10 6
  | 10 => RegisterComplement.complementBody 10
  | 11 => RegisterDivision.divideBody 2 7 8
  | 12 => RegisterQuotRem.body 11
  | 13 => RegisterNodeDecode.decodeBody 12 7 9
  | 14 => RegisterCoordinate.digitBody 6 7 9
  | 15 => RegisterCoordinates.wordsBody 15 14
  | 16 => RegisterNodeEncode.encodeBody 1 6
  | 17 => RegisterArcEmitter.emitBody
  | 18 => RegisterCandidate.candidateBody moves
  | 19 => RegisterListFlatMap.body 19 18
  | 20 => RegisterDigits.decodeBody 20 11
  | 21 => RegisterContextPack.body
  | 22 => RegisterExit.body 7 16 17
  | 23 => RegisterWorkSource.body work
  | 24 => RegisterHubSource.packBody
  | 25 => RegisterHubEntries.body 16 17
  | 26 => RegisterListFlatMap.body 26 25
  | 27 => RegisterWordRange.rangeBody 27 6 7
  | 28 => RegisterHubEntries.rangeBody 27 26
  | 29 => RegisterHubSource.hubSourceBody 24 28
  | 30 => RegisterSourceDispatch.body 13 29 23
  | 31 => RegisterListFlatMap.body 31 30
  | _ => RegisterAllSources.body 27 31

theorem program_matches : procedures.Matches program := by
  refine ⟨?_,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩
  refine ⟨?_,?_,rfl,rfl,rfl,rfl,rfl⟩
  · exact ⟨⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩
  · exact ⟨rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl,rfl⟩

/-- The input is actual stored sparse templates, signatures and costs. The
output is the concrete raw-arc list generated by this fixed 33-body table. -/
theorem correct {Row : Type*} {n cbits : ℕ} {key : Walks.State Row → Bits n}
    {data : GenerationData Row n cbits} {h : Heap} (hh : Valid h)
    {dp lp zp op acc : Ptr} {limit one : Bits n} {tail : List (RawArc Ptr n cbits)}
    (hg : GenerationAt key h dp data) (hl : BitsAt h lp limit) (hz : BitsAt h zp (Bits.zero n))
    (ho : BitsAt h op one) (hone : one.value = 1) (hdataOne : data.arithmetic.one.value = 1)
    (ht : TraceAt h acc tail) :
    ∃ out q, Extends h out ∧ Valid out ∧
      TraceAt out q (RegisterGraphEnumeration.entries key data limit ++ tail) ∧
      Within program h (initialRegisters [.pointer dp,.pointer lp,.pointer zp,.pointer op,.pointer acc])
        (program 32) [.pointer q] out
          (RegisterGraphEnumeration.budget n data.shape.length data.templates.length data.arithmetic.states.value limit.value) :=
  RegisterGraphEnumeration.compiled program procedures program_matches hh hg hl hz ho hone hdataOne ht

/-- The same execution has an explicit allocated-pointer and call-stack bit
cost; this bounds interpreter execution, not merely the number of graph arcs. -/
theorem bit_cost {Row : Type*} {n cbits : ℕ} {key : Walks.State Row → Bits n}
    {data : GenerationData Row n cbits} {h : Heap} (hh : Valid h)
    {dp lp zp op acc : Ptr} {limit one : Bits n} {tail : List (RawArc Ptr n cbits)}
    (hg : GenerationAt key h dp data) (hl : BitsAt h lp limit) (hz : BitsAt h zp (Bits.zero n))
    (ho : BitsAt h op one) (hone : one.value = 1) (hdataOne : data.arithmetic.one.value = 1)
    (ht : TraceAt h acc tail) :
    let steps := RegisterGraphEnumeration.budget n data.shape.length data.templates.length data.arithmetic.states.value limit.value
    ∃ out q events tree,
      FramedExec program h (initialRegisters [.pointer dp,.pointer lp,.pointer zp,.pointer op,.pointer acc])
        (program 32) ⟨[.pointer q],out,events⟩ tree ∧
      events.length ≤ steps ∧ (∀ stack, StackExec h stack tree.compile out stack) ∧
      stackBitCost tree.compile ≤ steps*(102+35*(h.length+steps).size) ∧
      TraceAt out q (RegisterGraphEnumeration.entries key data limit ++ tail) := by
  dsimp only
  obtain ⟨out,q,he,vo,hq,events,run,hlen⟩ := correct hh hg hl hz ho hone hdataOne ht
  have hdp : dp < h.length := by
    obtain ⟨_,_,_,_,_,_,hcell,_⟩ := hg
    exact List.getElem?_eq_some_iff.mp hcell |>.1
  have hargs : ValuesBound h.length [.pointer dp,.pointer lp,.pointer zp,.pointer op,.pointer acc] := by
    intro v hv
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hv
    rcases hv with rfl | rfl | rfl | rfl | rfl
    · exact hdp
    · exact hl.allocated
    · exact hz.allocated
    · exact ho.allocated
    · exact ht.allocated
  have hr := initialRegisters_bounded (null_allocated hh) hargs
  obtain ⟨tree,framed⟩ := run.framed
  exact ⟨out,q,events,tree,framed,hlen,framed.stack_exec,
    framed.bitCost_le_of_length_le hh hr hlen,hq⟩

end WeightedMIS.ExpandedEnumerationProgram
